<section class="max-w-4xl mx-auto px-6 py-20">
  <p class="text-xs mono uppercase tracking-widest text-amber-400 mb-3">Admin Panel</p>
  <h1 class="text-4xl mb-10">Manage Projects</h1>

  <!-- Add Project Form -->
  <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8 mb-10">
    <h2 class="text-lg font-semibold mb-6">Add New Project</h2>
    <form method="POST" action="/admin/projects" class="space-y-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-zinc-500 mono mb-1.5">Title</label>
          <input name="title" required placeholder="Project title" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 text-zinc-100 text-sm focus:outline-none focus:border-amber-400/50" />
        </div>
        <div>
          <label class="block text-xs text-zinc-500 mono mb-1.5">Year</label>
          <input name="year" type="number" value="2024" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 text-zinc-100 text-sm focus:outline-none focus:border-amber-400/50" />
        </div>
      </div>
      <div>
        <label class="block text-xs text-zinc-500 mono mb-1.5">Description</label>
        <textarea name="description" required rows="3" placeholder="Project description..." class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 text-zinc-100 text-sm focus:outline-none focus:border-amber-400/50 resize-none"></textarea>
      </div>
      <div>
        <label class="block text-xs text-zinc-500 mono mb-1.5">Tech Stack (comma separated)</label>
        <input name="tech_stack" required placeholder="Node.js, React, PostgreSQL" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 text-zinc-100 text-sm focus:outline-none focus:border-amber-400/50" />
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-zinc-500 mono mb-1.5">GitHub URL (optional)</label>
          <input name="github_url" type="url" placeholder="https://github.com/..." class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 text-zinc-100 text-sm focus:outline-none focus:border-amber-400/50" />
        </div>
        <div>
          <label class="block text-xs text-zinc-500 mono mb-1.5">Live URL (optional)</label>
          <input name="live_url" type="url" placeholder="https://..." class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-2.5 text-zinc-100 text-sm focus:outline-none focus:border-amber-400/50" />
        </div>
      </div>
      <div class="flex items-center gap-3">
        <input name="featured" type="checkbox" id="featured" class="w-4 h-4 accent-amber-400" />
        <label for="featured" class="text-sm text-zinc-400">Feature this project on the homepage</label>
      </div>
      <button type="submit" class="bg-amber-400 text-zinc-950 px-6 py-2.5 rounded-lg font-semibold text-sm hover:bg-amber-300 transition-colors">
        Add Project
      </button>
    </form>
  </div>

  <!-- Project List -->
  <div class="space-y-3">
    <h2 class="text-lg font-semibold mb-4">All Projects ({{projects.length}})</h2>
    {{#each projects}}
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <span class="font-medium text-zinc-100 text-sm">{{title}}</span>
          {{#if featured}}<span class="text-xs bg-amber-400/10 text-amber-400 border border-amber-400/20 px-2 py-0.5 rounded-full mono">featured</span>{{/if}}
          <span class="text-xs text-zinc-600 mono">{{year}}</span>
        </div>
        <p class="text-xs text-zinc-500 truncate">{{description}}</p>
        <div class="flex flex-wrap gap-1 mt-2">
          {{#each (split tech_stack ", ")}}
          <span class="mono text-xs bg-zinc-800 text-zinc-500 px-1.5 py-0.5 rounded">{{this}}</span>
          {{/each}}
        </div>
      </div>
      <button onclick="deleteProject({{id}}, this)" class="text-zinc-600 hover:text-red-400 transition-colors flex-shrink-0 p-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      </button>
    </div>
    {{/each}}
  </div>
</section>

<script>
async function deleteProject(id, btn) {
  if (!confirm('Delete this project?')) return;
  const row = btn.closest('div.bg-zinc-900');
  try {
    await fetch('/admin/projects/' + id, { method: 'DELETE' });
    row.remove();
  } catch (e) {
    alert('Error deleting project.');
  }
}
</script>
