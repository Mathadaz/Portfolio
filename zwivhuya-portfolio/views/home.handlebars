            </div>
          </li>
        </ul>
      </div>
      <!-- Contact quick links -->
      <div class="grid grid-cols-2 gap-4">
        <a href="mailto:zwivhuyamathada7@gmail.com" class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 hover:border-amber-400/30 transition-colors group">
          <div class="text-xs text-zinc-500 mono mb-1">Email</div>
          <div class="text-xs text-zinc-300 group-hover:text-amber-400 transition-colors break-all">zwivhuyamathada7@gmail.com</div>
        </a>
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
          <div class="text-xs text-zinc-500 mono mb-1">Phone</div>
          <div class="text-xs text-zinc-300">066 006 6345</div>
