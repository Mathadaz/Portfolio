              <div class="text-xs text-zinc-500 mono">IBM · 2026</div>
            </div>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-amber-400 flex-shrink-0"></span>
            <div>
              <div class="text-sm text-zinc-200">Microsoft Azure Fundamentals</div>
              <div class="text-xs text-zinc-500 mono">Microsoft &amp; LinkedIn · 2026</div>
            </div>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-amber-400 flex-shrink-0"></span>
            <div>
              <div class="text-sm text-zinc-200">Python for Data Analysis</div>
              <div class="text-xs text-zinc-500 mono">LinkedIn · 2026</div>
            </div>
          </li>
