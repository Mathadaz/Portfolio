</section>

<!-- Skills -->
<section id="skills" class="border-t border-zinc-800 bg-zinc-900/30">
  <div class="max-w-6xl mx-auto px-6 py-24">
    <p class="text-xs mono uppercase tracking-widest text-amber-400 mb-3">Skills &amp; Technologies</p>
    <h2 class="text-4xl mb-12">My technical toolkit</h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {{#each skillGroups}}
      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-amber-400 mono mb-5">{{@key}}</h3>
        <ul class="space-y-3">
          {{#each this}}
          <li>
            <div class="flex justify-between items-center mb-1.5">
              <span class="text-sm text-zinc-300">{{name}}</span>
              <span class="text-xs mono text-zinc-500">{{level}}%</span>
            </div>
            <div class="h-1 bg-zinc-800 rounded-full overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full skill-bar" style="width:0%" data-level="{{level}}"></div>
            </div>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Experience -->
<section id="experience" class="max-w-6xl mx-auto px-6 py-24">
  <p class="text-xs mono uppercase tracking-widest text-amber-400 mb-3">Background</p>
  <h2 class="text-4xl mb-12">Experience &amp; Education</h2>

  <div class="space-y-0">
    {{#each experience}}
    <div class="relative pl-8 pb-12 border-l border-zinc-800 last:border-transparent last:pb-0">
      <div class="absolute -left-[5px] top-0 w-2.5 h-2.5 rounded-full bg-amber-400"></div>
      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6 ml-4 hover:border-zinc-700 transition-colors">
        <div class="flex flex-wrap justify-between items-start gap-3 mb-3">
          <div>
            <h3 class="font-semibold text-zinc-100 text-lg">{{role}}</h3>
            <div class="text-amber-400 text-sm font-medium">{{company}}</div>
          </div>
          <span class="mono text-xs text-zinc-500 bg-zinc-800 px-3 py-1 rounded-full border border-zinc-700">{{period}}</span>
        </div>
        <p class="text-zinc-400 text-sm leading-relaxed">{{description}}</p>
      </div>
    </div>
    {{/each}}
  </div>
</section>

